# ParkEazy Monorepo Environment Variables
# Copy to .env for local development

# Application Environment
NODE_ENV=development

# Monorepo Development Ports
PORT_WEBSITE=3001
PORT_HOST=3002
PORT_ADMIN=3003
PORT_API=4000

# Backend API Configuration
API_PORT=4000
API_HOST=localhost
API_PREFIX=/api/v1
API_URL=http://localhost:4000

# Client Application API Targets
VITE_API_URL=http://localhost:4000/api/v1
VITE_DEFAULT_TENANT=default
VITE_APP_ENV=development

# Database Foundations (Part 03 - PostgreSQL)
# Local development default matches infrastructure/docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USER=parkeazy_user
DB_PASSWORD=parkeazy_password
DB_NAME=parkeazy_db
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Optional full connection URL (overrides separate DB_* keys if provided)
# DATABASE_URL=postgresql://parkeazy_user:parkeazy_password@localhost:5432/parkeazy_db

# Future Integrations (Placeholders - Deferred to later phases)
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=change-this-secret-in-production
