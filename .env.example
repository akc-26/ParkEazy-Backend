# ParkEazy Monorepo Environment Variables
# Copy to .env for local development

# Application Environment
NODE_ENV=development

# Monorepo Development Ports
PORT_WEBSITE=3001
PORT_HOST=3002
PORT_ADMIN=3003
PORT_API=4000

# Backend API Configuration
API_PORT=4000
API_HOST=localhost
API_PREFIX=/api/v1
API_URL=http://localhost:4000

# Client Application API Targets
VITE_API_URL=http://localhost:4000/api/v1
VITE_DEFAULT_TENANT=default
VITE_APP_ENV=development

# Future Integrations (Placeholders - Not enabled in Part 00)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parkeazy
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=change-this-secret-in-production
