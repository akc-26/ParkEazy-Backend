# ==============================================================================
# ParkEazy Parking Marketplace - Environment Configuration Reference
# Backend, Database, and Cache Baseline
# ==============================================================================

# Core Application Environment (development | test | production)
# In "production": PostgreSQL and Redis configurations are strictly MANDATORY.
NODE_ENV="development"

# Server Network Configuration
PORT=3000
HOST="0.0.0.0"
API_PREFIX="/api/v1"
BODY_LIMIT="1mb"
SHUTDOWN_TIMEOUT_MS=10000

# CORS Origins (comma-separated origins or * for open development access)
CORS_ORIGIN="*"

# PostgreSQL Database Configuration
# MANDATORY in production. Must be a valid postgresql:// or postgres:// connection string.
# In development/test: If omitted, ParkEazy runs in in-memory baseline mode (never labeled production-ready).
# Set DATABASE_REQUIRED="true" to strictly enforce database configuration in development/test.
DATABASE_REQUIRED="false"
DATABASE_URL="postgresql://parkeazy_user:placeholder_password@localhost:5432/parkeazy_db"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Redis Cache & Session Configuration
# MANDATORY in production. Must be a valid redis:// or rediss:// connection string.
# In development/test: If omitted, ParkEazy runs in in-memory baseline mode (never labeled production-ready).
# Set REDIS_REQUIRED="true" to strictly enforce Redis configuration in development/test.
REDIS_REQUIRED="false"
REDIS_URL="redis://localhost:6379"
REDIS_TIMEOUT_MS=3000

# Security & Authentication (Deployment Secret)
# In production: MUST be a high-entropy string of >= 32 characters.
JWT_SECRET="replace-with-secure-32-byte-hex-secret"
JWT_EXPIRY_SECONDS=86400
ENABLE_DEMO_AUTH="true"

# Logging & Observability
LOG_LEVEL="info"

# Cloud Hosting & Public URLs (Injected automatically in AI Studio / Cloud Run)
APP_URL="http://localhost:3000"
DISABLE_HMR="false"

# Note on Readiness Probing (/api/v1/readiness):
# Live connectivity is actively verified for PostgreSQL (SELECT 1) and Redis (PING).
# A connection URL alone is never treated as proof of connectivity.
# If either required dependency is missing or unreachable, readiness returns HTTP 503.
# In-memory development mode is explicitly reported and never labeled production-ready.

# Note on Payment & Notification Integrations (Phase 2.6):
# Provider credentials (Stripe, Razorpay, etc.) are managed dynamically via the Admin Panel
# and are encrypted at rest on the backend. No third-party provider keys are required for Stage 1.
# Host verification and account recovery delivery (configure before production)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
