{
    "name":  "parkeazy-monorepo",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "workspaces":  [
                       "apps/*",
                       "services/*",
                       "packages/*"
                   ],
    "scripts":  {
                    "dev":  "vite --port=3000 --host=0.0.0.0",
                    "dev:website":  "vite apps/website --port=3001 --host=0.0.0.0",
                    "dev:host":  "vite apps/host --port=3002 --host=0.0.0.0",
                    "dev:admin":  "vite apps/admin --port=3003 --host=0.0.0.0",
                    "dev:api":  "tsx services/api/src/main.ts",
                    "dev:all":  "node -e \"console.log(\u0027Launch dev:api, dev:website, dev:host, and dev:admin in separate terminal windows for parallel local execution.\u0027)\"",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "tsc --noEmit",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "clean":  "rm -rf dist server.js"
                },
    "dependencies":  {
                         "@google/genai":  "^2.4.0",
                         "@nestjs/common":  "^12.1.2",
                         "@nestjs/core":  "^12.1.2",
                         "@nestjs/platform-express":  "^12.1.2",
                         "@tailwindcss/vite":  "^4.3.3",
                         "@vitejs/plugin-react":  "^6.1.1",
                         "dotenv":  "^17.2.3",
                         "express":  "^4.21.2",
                         "lucide-react":  "^0.546.0",
                         "motion":  "^12.23.24",
                         "react":  "^19.0.1",
                         "react-dom":  "^19.0.1",
                         "reflect-metadata":  "^0.2.2",
                         "rxjs":  "^7.8.2",
                         "vite":  "^8.3.0"
                     },
    "devDependencies":  {
                            "@types/express":  "^4.17.21",
                            "@types/node":  "^22.14.0",
                            "@types/react":  "^19.3.0",
                            "@types/react-dom":  "^19.3.0",
                            "autoprefixer":  "^10.4.21",
                            "esbuild":  "^0.28.0",
                            "tailwindcss":  "^4.3.3",
                            "tsx":  "^4.21.0",
                            "typescript":  "^7.0.2",
                            "vitest":  "^5.0.3"
                        }
}
